<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 顶部标题 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1A2530" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="专为手部活动不便人士设计的全免手触屏交互驱动"
            android:textSize="13sp"
            android:textColor="#667788"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp" />

        <!-- 状态卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tv_service_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_service_stopped"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#E74C3C" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">

                <Button
                    android:id="@+id/btn_open_accessibility"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/btn_enable_accessibility"
                    android:textSize="13sp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btn_open_overlay"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/btn_enable_overlay"
                    android:textSize="13sp"
                    android:layout_marginStart="6dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 耳机硬件传感器连接诊断卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎧 耳机外设传感器源监测"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#0066CC" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="彻底屏蔽手机自带陀螺仪，100% 仅连接 Sony LinkBuds 硬件传感器"
                android:textSize="12sp"
                android:textColor="#8899AA"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="10dp" />

            <!-- 当前传感器识别状态 -->
            <TextView
                android:id="@+id/tv_sensor_source"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F8F9FA"
                android:padding="10dp"
                android:text="❌ 未检测到耳机传感器 (请确认佩戴耳机并开启蓝牙)"
                android:textColor="#E74C3C"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- 实时姿态数据 -->
            <TextView
                android:id="@+id/tv_sensor_angles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#EEF2F7"
                android:padding="10dp"
                android:text="实时姿态：Yaw(偏航): 0.0°  Pitch(俯仰): 0.0°  Roll(翻滚): 0.0°"
                android:textColor="#2C3E50"
                android:textSize="12sp"
                android:fontFamily="monospace" />

            <!-- 重新探测按钮 -->
            <Button
                android:id="@+id/btn_redetect_sensor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="🔄 重新探测并绑定耳机传感器"
                android:textSize="13sp"
                android:backgroundTint="#0066CC"
                android:textColor="#FFFFFF" />

            <!-- 手机固定支架备用开关 (手持手机严禁开启) -->
            <CheckBox
                android:id="@+id/cb_phone_fallback"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="📱 备用模式：允许手机支架陀螺仪（仅当手机固定于头部/轮椅随头动时使用）"
                android:textColor="#7F8C8D"
                android:textSize="12sp" />

            <!-- 诊断日志控制台 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="📋 底层硬件与外设诊断日志"
                android:textStyle="bold"
                android:textColor="#34495E"
                android:textSize="13sp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="4dp"
                android:background="#1E2227"
                android:padding="8dp">

                <TextView
                    android:id="@+id/tv_diagnostic_log"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#61AFEF"
                    android:textSize="10sp"
                    android:fontFamily="monospace"
                    android:text="正在初始化诊断引擎..." />
            </ScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="6dp">

                <Button
                    android:id="@+id/btn_copy_log"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="📋 复制诊断报告"
                    android:textSize="12sp"
                    android:backgroundTint="#4B5263"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_grant_bluetooth"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="🔑 授予蓝牙权限"
                    android:textSize="12sp"
                    android:backgroundTint="#2ECC71"
                    android:textColor="#FFFFFF"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

        </LinearLayout>

        <!-- 触屏拖动/滑动策略配置卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/drag_mode_title"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#0066CC" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="解决手机端上下浏览、拖拽与滚动的无障碍方案"
                android:textSize="12sp"
                android:textColor="#8899AA"
                android:layout_marginBottom="10dp" />

            <RadioGroup
                android:id="@+id/rg_drag_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/rb_mode_sticky"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/drag_mode_sticky"
                    android:checked="true"
                    android:textSize="14sp"
                    android:paddingVertical="6dp" />

                <RadioButton
                    android:id="@+id/rb_mode_flick"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/drag_mode_flick"
                    android:textSize="14sp"
                    android:paddingVertical="6dp" />

                <RadioButton
                    android:id="@+id/rb_mode_dock"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/drag_mode_dock"
                    android:textSize="14sp"
                    android:paddingVertical="6dp" />
            </RadioGroup>
        </LinearLayout>

        <!-- 右侧动作配置卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/right_action_title"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#0066CC" />

            <RadioGroup
                android:id="@+id/rg_right_action"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <RadioButton
                    android:id="@+id/rb_right_back"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/right_action_back"
                    android:checked="true"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rb_right_home"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/right_action_home"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/rb_right_recents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/right_action_recents"
                    android:textSize="14sp" />
            </RadioGroup>
        </LinearLayout>

        <!-- 悬停与歪头灵敏度卡片 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="参数微调"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#0066CC" />

            <!-- 悬停时间 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/dwell_time_label"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/tv_dwell_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.9 秒"
                    android:textStyle="bold"
                    android:textColor="#0066CC" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/sb_dwell"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="22"
                android:progress="6"
                android:layout_marginTop="4dp" />

            <!-- 歪头角度 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/tilt_threshold_label"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/tv_tilt_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10°"
                    android:textStyle="bold"
                    android:textColor="#0066CC" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/sb_tilt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="14"
                android:progress="4"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- 交互测试按钮 -->
        <Button
            android:id="@+id/btn_test_click"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/test_click_area"
            android:paddingVertical="14dp"
            android:backgroundTint="#EAECEF"
            android:textColor="#2C3E50"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
